        catch (Exception ex)
        {
            versionsErrorMessage = ex.Message;
        }
    }

    private async Task PublishDraft()
    {
        if (editingVersion == null) return;
        versionsErrorMessage = null;
        try
        {
            await PanelCatalogService.PublishVersionAsync(editingVersion.Id);
            editingVersion = null;
            await ReloadVersions();
        }
        catch (Exception ex)
        {
            versionsErrorMessage = ex.Message;
        }
    }


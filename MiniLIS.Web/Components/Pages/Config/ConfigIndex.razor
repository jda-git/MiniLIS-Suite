            var draft = await PanelCatalogService.CreateDraftVersionAsync(versionsPanel.Id, newVersionChangeNotes, vigente?.Id);
            showNewVersionPrompt = false;
            await ReloadVersions();
            var reloaded = panelVersions.FirstOrDefault(v => v.Id == draft.Id);

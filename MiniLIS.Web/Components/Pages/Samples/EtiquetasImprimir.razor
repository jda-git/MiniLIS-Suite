@page "/etiquetas/imprimir"
@using MiniLIS.Application.Interfaces
@using MiniLIS.Domain.Entities
@using MiniLIS.Infrastructure.Services
@using Microsoft.AspNetCore.Authorization
@using System.Globalization
@using System.Net
@attribute [Authorize]
@inject ISampleService SampleService
@inject IStorageService StorageService
@inject IMasterDataService MasterService
@inject ILocalTimeService LocalTimeService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Etiquetas - MiniLIS Suite</PageTitle>

@if (isLoading)
{
    <div class="text-center py-5 no-print"><span class="spinner-border text-primary"></span></div>
}
else if (!sampleItems.Any() && !tubeItems.Any() && !specimenItems.Any())
{
    <div class="alert alert-warning no-print m-4">No se ha encontrado ninguna muestra ni alícuota para las etiquetas solicitadas.</div>
}
else
{
    <div class="print-toolbar no-print">
        <button class="btn btn-primary btn-sm" disabled="@(totalLabels == 0)" @onclick="Imprimir"><i class="bi bi-printer"></i> Imprimir (@totalLabels etiqueta@(totalLabels == 1 ? "" : "s"))</button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="Volver">Volver</button>
    </div>

    <div class="label-selector no-print">
        <div class="label-selector-col">
            <h6>ETIQUETA MUESTRA</h6>
            @foreach (var item in sampleItems)
            {
                <div class="label-selector-row">
                    <input type="checkbox" @bind="item.Selected" />
                    @BuildLabelMarkup(item)
                </div>
            }
        </div>

        @if (tubeItems.Any())
        {
            <div class="label-selector-col">
                <h6>ETIQUETAS TUBOS</h6>
                @foreach (var item in tubeItems)
                {
                    <div class="label-selector-row">
                        <input type="checkbox" @bind="item.Selected" />
                        @BuildLabelMarkup(item)
                    </div>
                }
                <div class="label-selector-row label-selector-all">
                    <input type="checkbox" checked="@allTubesSelected" @onchange="@(e => SetAllTubesSelected((bool)(e.Value ?? false)))" />
                    <span>TODAS</span>
                </div>
            </div>
        }

        @if (specimenItems.Any())
        {
            <div class="label-selector-col">
                <h6>ETIQUETAS ALÍCUOTAS</h6>
                @foreach (var item in specimenItems)
                {
                    <div class="label-selector-row">
                        <input type="checkbox" @bind="item.Selected" />
                        @BuildLabelMarkup(item)
                    </div>
                }
            </div>
        }
    </div>

    <div class="labels-sheet print-only">
        @foreach (var item in sampleItems.Where(i => i.Selected).Concat(tubeItems.Where(i => i.Selected)).Concat(specimenItems.Where(i => i.Selected)))
        {
            for (var copy = 0; copy < settings.CopiesPerSample; copy++)
            {
                @BuildLabelMarkup(item)
            }
        }
    </div>
}

<style>
    .no-print { }
    @@media print {
        .no-print { display: none !important; }
        /* :not(:last-child) -- con page-break-after en TODAS las etiquetas, la última
           también fuerza un salto, y ese salto produce una página en blanco de más al
           final (visible incluso imprimiendo una sola etiqueta). */
        .label:not(:last-child) { page-break-after: always; }
    }
    @@page {
        size: @(settings.WidthMm.ToString(CultureInfo.InvariantCulture))mm @(settings.HeightMm.ToString(CultureInfo.InvariantCulture))mm;
        margin: 0;
    }

    .print-toolbar { display: flex; gap: 10px; padding: 16px; }

    .label-selector { display: flex; gap: 32px; flex-wrap: wrap; padding: 0 16px 16px; }
    .label-selector-col { display: flex; flex-direction: column; gap: 10px; }
    .label-selector-col h6 { margin: 0 0 4px; font-weight: 700; color: #334155; font-size: 0.85rem; letter-spacing: 0.03em; }
    .label-selector-row { display: flex; align-items: center; gap: 8px; }
    .label-selector-row input[type="checkbox"] { width: 1em; height: 1em; flex-shrink: 0; }
    .label-selector-all { margin-top: 4px; font-weight: 600; color: #334155; }

    /* .labels-sheet.print-only (selector compuesto, no ".print-only" suelto): así su
       especificidad no depende de qué regla aparezca después en la hoja -- con dos
       selectores de una sola clase para el mismo elemento (".print-only{display:none}" y
       ".labels-sheet{display:flex}"), gana la que esté escrita más abajo en el CSS
       independientemente de cuál "debería" ganar, y aquí ".labels-sheet" iba después:
       el bloque quedaba visible en pantalla con display:flex en vez de oculto. */
    .labels-sheet.print-only {
        display: none;
        flex-direction: column;
        align-items: flex-start;
        gap: 4mm;
        padding: 4mm;
    }

    @@media print {
        /* La regla @@page de arriba ya define el tamaño exacto de una etiqueta con margen
           0 -- este padding y gap son solo para que se vea cómodo en pantalla. En
           impresión, cualquier espacio aquí desplaza el contenido dentro de una página
           que no tiene hueco de sobra (queda cortado por overflow:hidden en vez de
           centrado). */
        .labels-sheet.print-only { display: flex; padding: 0; gap: 0; }
    }

    .label {
        box-sizing: border-box;
        border: 1px solid #cbd5e1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        font-family: Arial, sans-serif;
        overflow: hidden;
        line-height: 1;
    }
    /* Altura de línea fija (1) en vez de "normal": la altura de línea "normal" del
       navegador no está estandarizada -- Chrome en pantalla y el motor de impresión de
       Adobe PDF (u otros drivers que no pasan por el renderer del navegador) la calculan
       de forma distinta. Con la altura por defecto de la etiqueta (25mm) ese margen extra
       bastaba para que el contenido se saliera del recuadro al imprimir aunque en pantalla
       cupiera bien. Con line-height:1 la altura real es predecible y cabe con margen.
       Ver también BuildBarcodeSvg, que ya calcula su alto a partir de settings.BarcodeHeightMm. */
    .label-main-row { display: flex; justify-content: space-between; align-items: baseline; margin-top: 0.5mm; }
    .label-number { font-weight: 700; color: #0f172a; }
    .label-type { font-weight: 700; color: #0f172a; }
    .label-id { color: #1e293b; margin-top: 0.3mm; }
    .label-date { color: #475569; margin-top: 0.3mm; }
    .label-date-row { display: flex; justify-content: space-between; align-items: baseline; color: #475569; margin-top: 0.3mm; gap: 2mm; }
    .label-date-row span:last-child { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .label-noid { background: #0f172a; color: #fff; font-weight: 700; padding: 0.5mm 1mm; display: inline-block; margin-top: 0.3mm; }
    /* Lista de monoclonales del tubo (en vez de NHC/NASI en las etiquetas de tubo): una
       sola línea, cortada con puntos suspensivos si no cabe en el ancho de la etiqueta,
       en vez de desbordar o pasar a una segunda línea (la etiqueta no tiene alto de sobra). */
    .label-tube { color: #1e293b; margin-top: 0.3mm; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }

    @@media print {
        .label { border: none; }
    }
</style>

@code {
    [SupplyParameterFromQuery]
    public string? Ids { get; set; }

    // F-7: alícuotas de excedente (Excedente.razor → "Imprimir etiquetas del lote"), fuente
    // de datos independiente de Ids (muestras/tubos) -- las dos pueden convivir en teoría,
    // aunque en la práctica cada botón de origen solo rellena una de las dos.
    [SupplyParameterFromQuery]
    public string? SpecimenIds { get; set; }

    private List<Sample> samples = new();
    private LabelSettings settings = new();
    private bool isLoading = true;

    private List<LabelItem> sampleItems = new();
    private List<LabelItem> tubeItems = new();
    private List<LabelItem> specimenItems = new();

    private int totalLabels => (sampleItems.Count(i => i.Selected) + tubeItems.Count(i => i.Selected) + specimenItems.Count(i => i.Selected)) * settings.CopiesPerSample;
    private bool allTubesSelected => tubeItems.Count > 0 && tubeItems.All(i => i.Selected);

    private class LabelItem
    {
        public bool Selected;
        public string SampleNumber = "";
        public string TypeCode = "";
        public string? IdLine;
        public string? DateLine;
        public string? TubeLine;
        public string? AliquotTypeLine;
        /// <summary>Nombre completo del tipo de alícuota (Células, Pellet, DNA...), mostrado
        /// junto a la fecha de almacenamiento -- AliquotTypeLine ya lleva el código de 3
        /// letras (TUB, CEL...) en la línea de arriba, este es el nombre legible.</summary>
        public string? TypeName;
        /// <summary>Dato codificado en el código de barras -- por defecto SampleNumber
        /// (muestras/tubos, donde el número de muestra ya es único); las alícuotas necesitan
        /// algo más específico, porque varias comparten SampleNumber (F-7).</summary>
        public string? BarcodeData;
    }

    protected override async Task OnInitializedAsync()
    {
        settings = await MasterService.GetLabelSettingsAsync();

        var ids = ParseIdList(Ids);
        samples = ids.Any() ? await SampleService.GetSamplesByIdsAsync(ids) : new List<Sample>();

        var specimenIds = ParseIdList(SpecimenIds);
        var specimens = specimenIds.Any() ? await StorageService.GetByIdsAsync(specimenIds) : new List<StoredSpecimen>();

        BuildLabelItems(specimens);
        isLoading = false;
    }

    private static List<int> ParseIdList(string? raw) => (raw ?? string.Empty)
        .Split(',', StringSplitOptions.RemoveEmptyEntries)
        .Select(s => int.TryParse(s.Trim(), out var id) ? id : (int?)null)
        .Where(id => id.HasValue)
        .Select(id => id!.Value)
        .Distinct()
        .ToList();

    private void BuildLabelItems(List<StoredSpecimen> specimens)
    {
        sampleItems = new List<LabelItem>();
        tubeItems = new List<LabelItem>();
        specimenItems = new List<LabelItem>();

        foreach (var s in samples)
        {
            var patient = s.ClinicalRequest?.Patient;
            var hasNhc = !string.IsNullOrWhiteSpace(patient?.NHC);
            var hasNasi = !string.IsNullOrWhiteSpace(patient?.NASI);
            var idLine = hasNhc ? $"NHC: {patient!.NHC}" : (hasNasi ? $"NASI: {patient!.NASI}" : null);

            sampleItems.Add(new LabelItem
            {
                Selected = true,
                SampleNumber = s.SampleNumber,
                TypeCode = s.SampleType.ToCode(),
                IdLine = idLine,
                DateLine = LocalTimeService.ToLocal(s.ReceivedAtUtc ?? s.ReceptionDate).ToString("dd/MM/yyyy HH:mm")
            });

            foreach (var panel in s.Panels)
            {
                foreach (var tube in panel.Tubes)
                {
                    tubeItems.Add(new LabelItem
                    {
                        Selected = false,
                        SampleNumber = s.SampleNumber,
                        TypeCode = s.SampleType.ToCode(),
                        TubeLine = $"T{tube.TubeNumber}: {tube.MarkerList}"
                    });
                }
            }
        }

        foreach (var sp in specimens)
        {
            var sampleNumber = sp.Sample?.SampleNumber ?? "";
            var typeCode = sp.Type.ToCode();
            specimenItems.Add(new LabelItem
            {
                Selected = true,
                SampleNumber = sampleNumber,
                TypeCode = typeCode,
                AliquotTypeLine = $"{typeCode} {sp.AliquotIndex}/{sp.BatchSize}",
                // "{muestra}(T{índice})" -- legible y único: identifica la alícuota sin
                // depender del Id interno de base de datos. BuildBarcodeSvg ya no estira el
                // código para llenar el ancho de la etiqueta (ese era el bug de las barras
                // ilegibles), así que un dato algo más largo que un simple Id ya no supone
                // ningún riesgo de desbordar ni de engordar las barras.
                BarcodeData = $"{sampleNumber}(T{sp.AliquotIndex})",
                // Fecha de almacenamiento, no de recepción -- mismo formato que la columna
                // "Almacenada" del CSV de excedentes (StorageService.ExportToCsvAsync).
                DateLine = LocalTimeService.ToLocal(sp.StoredAtUtc).ToString("dd/MM/yyyy"),
                TypeName = sp.Type == StoredSpecimenType.Otros && !string.IsNullOrWhiteSpace(sp.TypeOther)
                    ? sp.TypeOther
                    : sp.Type.ToDisplayName()
            });
        }
    }

    private void SetAllTubesSelected(bool value)
    {
        foreach (var item in tubeItems) item.Selected = value;
    }

    private async Task Imprimir()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private void Volver()
    {
        if (!sampleItems.Any() && !tubeItems.Any() && specimenItems.Any())
        {
            Nav.NavigateTo("/excedente");
        }
        else
        {
            Nav.NavigateTo("/muestras");
        }
    }

    // Construye el mismo marcado para el selector en pantalla y para la hoja de impresión
    // (.labels-sheet): así lo que se selecciona es exactamente lo que se imprime, en vez de
    // mantener dos plantillas separadas que puedan divergir (ver el historial de bugs de
    // impresión de esta misma página).
    private MarkupString BuildLabelMarkup(LabelItem item)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append($@"<div class=""label"" style=""width:{settings.WidthMm.ToString(CultureInfo.InvariantCulture)}mm; height:{settings.HeightMm.ToString(CultureInfo.InvariantCulture)}mm; padding:{settings.MarginMm.ToString(CultureInfo.InvariantCulture)}mm;"">");
        sb.Append(BuildBarcodeSvg(item.BarcodeData ?? item.SampleNumber));
        sb.Append(@"<div class=""label-main-row"">");
        sb.Append($@"<span class=""label-number"" style=""font-size:{settings.MainFontPt}pt;"">{WebUtility.HtmlEncode(item.SampleNumber)}</span>");
        if (settings.ShowSampleType && item.AliquotTypeLine == null)
        {
            sb.Append($@"<span class=""label-type"" style=""font-size:{settings.MainFontPt}pt;"">{WebUtility.HtmlEncode(item.TypeCode)}</span>");
        }
        sb.Append("</div>");

        if (item.TubeLine != null)
        {
            sb.Append($@"<div class=""label-tube"" style=""font-size:{settings.SecondaryFontPt}pt;"">{WebUtility.HtmlEncode(item.TubeLine)}</div>");
        }
        else if (item.AliquotTypeLine != null)
        {
            sb.Append($@"<div class=""label-tube"" style=""font-size:{settings.SecondaryFontPt}pt;"">{WebUtility.HtmlEncode(item.AliquotTypeLine)}</div>");
        }
        else if (item.IdLine != null)
        {
            sb.Append($@"<div class=""label-id"" style=""font-size:{settings.SecondaryFontPt}pt;"">{WebUtility.HtmlEncode(item.IdLine)}</div>");
        }
        else
        {
            sb.Append($@"<div class=""label-noid"" style=""font-size:{settings.SecondaryFontPt}pt;"">SIN IDENTIFICADOR</div>");
        }

        // Para alícuotas la fecha de almacenamiento siempre se muestra -- es su propio dato de
        // trazabilidad, no la "fecha de recepción" que gobierna settings.ShowReceptionDate (esa
        // casilla es específica de las etiquetas de muestra, ver ConfigIndex.razor).
        if (item.TubeLine == null && item.DateLine != null && (item.AliquotTypeLine != null || settings.ShowReceptionDate))
        {
            if (item.TypeName != null)
            {
                // Fecha a la izquierda, tipo de alícuota (Células, Pellet, DNA...) a la
                // derecha, en la misma línea -- mismo patrón flex que label-main-row.
                sb.Append($@"<div class=""label-date-row"" style=""font-size:{settings.SecondaryFontPt}pt;"">");
                sb.Append($@"<span>{WebUtility.HtmlEncode(item.DateLine)}</span>");
                sb.Append($@"<span>{WebUtility.HtmlEncode(item.TypeName)}</span>");
                sb.Append("</div>");
            }
            else
            {
                sb.Append($@"<div class=""label-date"" style=""font-size:{settings.SecondaryFontPt}pt;"">{WebUtility.HtmlEncode(item.DateLine)}</div>");
            }
        }

        sb.Append("</div>");
        return (MarkupString)sb.ToString();
    }

    // Code 128B renderizado directamente a SVG (F-5): sin dependencia de generación de
    // imágenes (SkiaSharp/ImageSharp), coherente con el resto de gráficos del proyecto (F-1).
    private string BuildBarcodeSvg(string data)
    {
        var widths = Code128Encoder.EncodeToModuleWidths(data);
        var totalModules = widths.Sum();

        // Ancho de módulo (X-dimension) FIJO, no "el que haga falta para llenar el ancho
        // disponible": con datos cortos (p. ej. el Id de una alícuota, muchos menos módulos
        // que un número de muestra) estirar el código para ocupar todo el ancho produce
        // barras anormalmente gruesas -- deja de parecerse a un Code128 real y un lector de
        // mano no lo decodifica (comprobado: "no es legible por el lector"). 0.33mm es un
        // ancho de módulo cómodo y habitual para lectores estándar a la distancia de uso en
        // laboratorio. Solo se reduce (nunca se amplía) si el código no cupiera en la
        // etiqueta con ese ancho -- eso sí puede pasar con datos largos, no con datos cortos.
        const double targetModuleWidthMm = 0.33;
        double svgHeightMm = settings.BarcodeHeightMm;
        double availableWidthMm = settings.WidthMm - 2 * settings.MarginMm;
        double moduleWidthMm = Math.Min(targetModuleWidthMm, Math.Max(0.25, availableWidthMm / totalModules));
        double svgWidthMm = moduleWidthMm * totalModules;

        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg width=\"{svgWidthMm.ToString(System.Globalization.CultureInfo.InvariantCulture)}mm\" height=\"{svgHeightMm.ToString(System.Globalization.CultureInfo.InvariantCulture)}mm\" viewBox=\"0 0 {totalModules} 1\" preserveAspectRatio=\"none\" xmlns=\"http://www.w3.org/2000/svg\">");
        sb.Append("<rect x=\"0\" y=\"0\" width=\"100%\" height=\"100%\" fill=\"white\"/>");

        double x = 0;
        var isBar = true;
        foreach (var w in widths)
        {
            if (isBar)
            {
                sb.Append($"<rect x=\"{x.ToString(System.Globalization.CultureInfo.InvariantCulture)}\" y=\"0\" width=\"{w}\" height=\"1\" fill=\"black\"/>");
            }
            x += w;
            isBar = !isBar;
        }
        sb.Append("</svg>");
        return sb.ToString();
    }
}

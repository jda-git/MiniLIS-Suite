@page "/acceso-denegado"
@using Microsoft.AspNetCore.Authorization
@layout MiniLIS.Web.Components.Layout.LoginLayout
@attribute [Authorize]

<PageTitle>Acceso Denegado - MiniLIS Suite</PageTitle>

<div class="tech-auth-overlay">
    <div class="auth-card animate-fade-in shadow-2xl">
        <div class="auth-header">
            <div class="auth-logo-container">
                <i class="bi bi-shield-x text-tech-red"></i>
            </div>
            <div class="auth-titles">
                <h1 class="auth-title">Acceso Denegado</h1>
                <p class="auth-subtitle">SU ROL NO TIENE PERMISO PARA ESTE RECURSO</p>
            </div>
        </div>

        <div class="auth-body">
            <p class="text-tech-muted">
                Ha intentado acceder a una sección para la que su perfil de usuario no está autorizado.
                Si considera que esto es un error, contacte con el administrador del sistema.
            </p>

            <div class="d-flex gap-3 mt-4">
                <a href="/" class="btn btn-tech-action">
                    <i class="bi bi-house-door me-2"></i>Volver al panel
                </a>
                <form action="/account/logout" method="get" class="m-0">
                    <button type="submit" class="btn btn-tech-outline">Salir</button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .tech-auth-overlay {
        min-height: 100vh; display: flex; align-items: center; justify-content: center;
        background-color: #0f172a;
        background-image: radial-gradient(at 0% 0%, rgba(239, 68, 68, 0.12) 0, transparent 50%),
            radial-gradient(at 100% 100%, rgba(14, 165, 233, 0.1) 0, transparent 50%);
        padding: 20px; font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }
    .auth-card {
        width: 100%; max-width: 480px; background: rgba(30, 41, 59, 0.7);
        backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(51, 65, 85, 0.8); border-radius: 4px; overflow: hidden;
    }
    .auth-header { padding: 40px 40px 20px; display: flex; align-items: center; gap: 20px; }
    .auth-logo-container { font-size: 2.5rem; }
    .text-tech-red { color: #ef4444; }
    .auth-title { color: #fff; font-size: 1.4rem; font-weight: 700; margin: 0; }
    .auth-subtitle { color: #94a3b8; font-size: 0.7rem; margin: 0; letter-spacing: 1.5px; font-weight: 500; }
    .auth-body { padding: 0 40px 40px; }
    .text-tech-muted { color: #94a3b8; font-size: 0.9rem; }
    .btn-tech-action {
        background: #0ea5e9; color: #fff; border: none; border-radius: 4px; padding: 12px 20px;
        font-size: 0.9rem; text-decoration: none; display: inline-flex; align-items: center;
    }
    .btn-tech-action:hover { background: #0284c7; color: #fff; }
    .btn-tech-outline {
        background: transparent; color: #94a3b8; border: 1px solid rgba(51, 65, 85, 0.8);
        border-radius: 4px; padding: 12px 20px; font-size: 0.9rem;
    }
    .btn-tech-outline:hover { color: #fff; border-color: #94a3b8; }
    .animate-fade-in { animation: fadeIn 0.6s ease-out; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>

@using MiniLIS.Application.Interfaces
<div class="iso-sidebar-header">
    <div class="iso-logo">
        <i class="bi bi-shield-check text-info me-2 h5 mb-0"></i> 
        <span>MiniLIS Suite</span>
    </div>
</div>

<nav class="iso-nav">
    @* v4.1: cada entrada aparece si el rol tiene el permiso correspondiente
       (Configuración → Permisos). *@
    <AuthorizeView Policy="@Permissions.Policies.MuestrasVer">
        <Authorized>
            <NavLink class="iso-nav-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-grid-1x2"></i> Dashboard
            </NavLink>
            <NavLink class="iso-nav-link" href="muestras">
                <i class="bi bi-calendar3"></i> Bandeja Técnica
            </NavLink>
            <NavLink class="iso-nav-link" href="trabajo">
                <i class="bi bi-kanban"></i> Lista de Trabajo
            </NavLink>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Policy="@Permissions.Policies.HojaTrabajoGenerar">
        <Authorized>
            <NavLink class="iso-nav-link" href="hoja-trabajo">
                <i class="bi bi-file-earmark-arrow-down"></i> Hoja del Citómetro
            </NavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Policy="@Permissions.Policies.ConfiguracionVer">
        <Authorized><div class="nav-section-title">ADMINISTRACIÓN</div>
            <NavLink class="iso-nav-link" href="configuracion">
                <i class="bi bi-gear"></i> Configuración
            </NavLink>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Policy="@Permissions.Policies.PanelVersionesVer">
        <Authorized>
            <NavLink class="iso-nav-link" href="paneles/versiones">
                <i class="bi bi-clock-history"></i> Versiones de paneles
            </NavLink>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Policy="@Permissions.Policies.NotificacionesVer">
        <Authorized>
            <NavLink class="iso-nav-link" href="notificaciones">
                <i class="bi bi-bell"></i> Notificaciones
            </NavLink>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Policy="@Permissions.Policies.ExcedenteVer">
        <Authorized>
            <NavLink class="iso-nav-link" href="excedente">
                <i class="bi bi-box-seam"></i> Excedente
            </NavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Policy="@Permissions.Policies.UsuariosGestionar">
        <Authorized><div class="nav-section-title">PANEL AVANZADO</div>
            <NavLink class="iso-nav-link" href="usuarios">
                <i class="bi bi-people"></i> Usuarios
            </NavLink>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Policy="@Permissions.Policies.BuscadorVer">
        <Authorized>
            <NavLink class="iso-nav-link" href="buscador">
                <i class="bi bi-search"></i> Buscador
            </NavLink>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Policy="@Permissions.Policies.IndicadoresVer">
        <Authorized>
            <NavLink class="iso-nav-link" href="indicadores">
                <i class="bi bi-graph-up-arrow"></i> Indicadores
            </NavLink>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Policy="@Permissions.Policies.AuditoriaVer">
        <Authorized>
            <NavLink class="iso-nav-link" href="auditoria">
                <i class="bi bi-shield-lock"></i> Auditoría
            </NavLink>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Policy="@Permissions.Policies.BackupGestionar">
        <Authorized>
            <NavLink class="iso-nav-link" href="backup">
                <i class="bi bi-cloud-arrow-up"></i> Backup
            </NavLink>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Policy="@Permissions.Policies.ContingenciaGestionar">
        <Authorized>
            <NavLink class="iso-nav-link" href="contingencia">
                <i class="bi bi-shield-exclamation"></i> Contingencia
            </NavLink>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Policy="@Permissions.Policies.EvidenciasGenerar">
        <Authorized>
            <NavLink class="iso-nav-link" href="evidencias">
                <i class="bi bi-archive"></i> Evidencias
            </NavLink>
        </Authorized>
    </AuthorizeView>
</nav>

<style>
    .iso-sidebar-header {
        height: 60px;
        display: flex;
        align-items: center;
        padding: 0 20px;
        background-color: #171c22;
        border-bottom: 1px solid #2a333d;
    }
    .iso-logo {
        font-weight: 700;
        letter-spacing: 1px;
        font-size: 16px;
        display: flex;
        align-items: center;
        color: white;
    }
    
    .iso-nav {
        padding: 20px 0;
        display: flex;
        flex-direction: column;
    }
    
    .nav-section-title {
        font-size: 10px;
        font-weight: 700;
        color: #58697a;
        padding: 24px 20px 10px 20px;
        letter-spacing: 1px;
    }
    
    .iso-nav-link {
        display: flex;
        align-items: center;
        padding: 12px 20px;
        color: #a0aec0;
        text-decoration: none;
        font-size: 13px;
        font-weight: 500;
        border-left: 3px solid transparent;
        transition: all 0.2s;
    }
    
    .iso-nav-link i {
        margin-right: 12px;
        font-size: 15px;
    }
    
    .iso-nav-link:hover {
        background-color: #242c36;
        color: white;
    }
    
    .iso-nav-link.active {
        background-color: #2b3543;
        color: white;
        border-left: 3px solid #f5a623; /* ISO Yellow active border */
    }
</style>
